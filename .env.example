# Configuração do Banco de Dados
# Para desenvolvimento local, deixe comentado para usar SQLite
# DATABASE_URL=postgresql://bah_user:bah_password@localhost:5432/bah_db

# Para usar PostgreSQL (Docker ou produção)
# DATABASE_URL=postgresql://bah_user:bah_password@localhost:5432/bah_db

# Configurações da Aplicação
# DEBUG=true
# LOG_LEVEL=info

# Configurações do Banco PostgreSQL (se usar Docker)
# POSTGRES_DB=bah_db
# POSTGRES_USER=bah_user
# POSTGRES_PASSWORD=bah_password
