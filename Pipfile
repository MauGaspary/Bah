[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "~=0.115.14"
uvicorn = "~=0.34.3"
pydantic = "~=2.11.7"
httpx = "~=0.27.2"
sqlalchemy = "~=2.0.23"
psycopg2-binary = "~=2.9.9"
alembic = "~=1.13.1"
pyjwt = "*"
python-dotenv = "*"
pytest = "*"
bcrypt = "~=4.0.1"

[dev-packages]
black = "~=24.10.0"
isort = "~=5.13.2"
pre-commit = "==4.0.1"
pylint = "~=3.3.2"
pytest-cov = "~=6.0.0"

[requires]
python_version = "3.12"

[scripts]
app = "uvicorn app.main:app --reload"
test = "pytest tests -vv --show-capture=all"
"test:cov" = "pytest --cov=app --cov-report=term-missing --cov-fail-under=80 tests"
"test:cov:html" = "pytest --cov=app --cov-report=html tests"
"lint:all" = "pylint app tests"
"pylint:all" = "pylint app"
"isort:all" = "isort --profile black ."
"format:all" = "black ."
precommit = "pre-commit run --all-files"
migrate = "alembic upgrade head"
"migrate:create" = "alembic revision --autogenerate -m 'auto migration'"
"migrate:history" = "alembic history"
"migrate:current" = "alembic current"
seed = "python -m app.scripts.seed"
